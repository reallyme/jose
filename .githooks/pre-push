set -eu
directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$directory/check_repository_privacy.py" ]; then
  exec python3 "$directory/check_repository_privacy.py" push
fi
root=$(git rev-parse --show-toplevel)
exec python3 "$root/scripts/check_repository_privacy.py" push
