# Keep generated JVM sources byte-identical when Git for Windows enables CRLF.
gen/java/**/*.java text eol=lf
gen/kotlin/**/*.kt text eol=lf

# CI invokes these launchers through Bash, including on Windows.
packages/*/gradlew text eol=lf
packages/*/gradlew.bat text eol=crlf
scripts/**/*.sh text eol=lf
.githooks/* text eol=lf
